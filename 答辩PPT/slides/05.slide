<Slide style={{ background: '#FFFFFF', width: '1280px', height: '720px', padding: 0 }}>
  <Box style={{ height: 88, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', padding: '0 40px', gap: 16 }}>
    <Box style={{ width: 6, height: 28, background: '#3D7BD9', borderRadius: 3 }} />
    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF' }}>技术路线 · 六步流水线</Text>
  </Box>
  <Box style={{ flex: 1, padding: '40px 40px 30px', gap: 30 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
      {[
        { n: '①', t: '自然语言', s: '说人话描述需求' },
        { n: '②', t: 'LLM Prompt', s: '给大脑写说明书' },
        { n: '③', t: '结构化 JSON', s: 'BOM + 网表' },
        { n: '④', t: 'KiCad 脚本', s: 'Python 驱动 eeschema' },
        { n: '⑤', t: '原理图·PCB', s: 'KiCad 可打开' },
        { n: '⑥', t: 'DRC 闭环', s: '检查·反馈·迭代' },
      ].map((s, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center' }}>
          <Box style={{ width: 168, flexDirection: 'column', alignItems: 'center', gap: 10, padding: '20px 10px', background: '#F0F5FC', border: '1.5px solid #3D7BD9', borderRadius: 12 }}>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E4FA8' }}>{s.n}</Text>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230', textAlign: 'center' }}>{s.t}</Text>
            <Text style={{ fontSize: 12, color: '#4A5568', textAlign: 'center' }}>{s.s}</Text>
          </Box>
          {i < 5 && <Text style={{ fontSize: 22, color: '#3D7BD9', margin: '0 6px' }}>→</Text>}
        </Box>
      ))}
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 24 }}>
      <Box style={{ flex: 1, background: '#F7F9FC', borderRadius: 12, padding: '22px 24px', gap: 8 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>三层分工</Text>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.7 }}>
          LLM 是<span style={{ fontWeight: 'bold', color: '#1A2230' }}>大脑</span>（理解需求），
          Python 是<span style={{ fontWeight: 'bold', color: '#1A2230' }}>手脚</span>（解析 JSON、驱动 KiCad），
          KiCad 是<span style={{ fontWeight: 'bold', color: '#1A2230' }}>成果载体</span>（真实可打开的工程）。
        </Text>
      </Box>
      <Box style={{ flex: 1, background: '#0E3F8C', borderRadius: 12, padding: '22px 24px', gap: 8 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#8FB3E8' }}>反馈闭环</Text>
        <Text style={{ fontSize: 15, color: '#FFFFFF', lineHeight: 1.7 }}>
          发现错误 → 改提示词 / 改设计 → 自动再来一轮，像「做完题再检查一遍」。
        </Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
    <Text style={{ fontSize: 13, color: '#8B97A8' }}>山东大学未来技术学院</Text>
    <Text style={{ fontSize: 14, color: '#1E4FA8', fontWeight: 'bold' }}>05 / 13</Text>
  </Box>
</Slide>
